{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
    "prettier.config.js",
    "vite.config.js"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "geojson"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "exclude": [
    "src/features/admin/posts",
    "src/features/admin/dashboard",
    "src/features/admin/devices",
    "src/features/admin/bulletins",
    "src/features/admin/schedules",
    "src/features/admin/reports",
    "src/routes/_dashboard/dashboard/posts",
    "src/routes/_dashboard/dashboard/bulletins/categories",
    "src/routes/_dashboard/dashboard/bulletins/new",
    "src/routes/_dashboard/dashboard/bulletins/$bulletinId"
  ]
}
